# 복사: cp .env.example .env
# 실클라우드 URL / 실토큰 / 고객·사내 호스트명은 넣지 마세요. 로컬 stub 값만 사용합니다.

BASE_URL=http://127.0.0.1:8765
STUB_HOST=127.0.0.1
STUB_PORT=8765

# 데모 전용 가짜 자격 증명
DEMO_USERNAME=qa-demo
DEMO_PASSWORD=demo-pass-1234
JWT_SECRET=demo-only-secret-not-for-prod

# access 토큰을 짧게 두어 refresh 데몬이 바로 보이도록 함 (초)
ACCESS_TOKEN_TTL=8
REFRESH_TOKEN_TTL=120

# 선택: 데몬 락/상태 경로
# TOKEN_DAEMON_LOCK=artifacts/token_refresh.lock
# TOKEN_DAEMON_STATE=artifacts/token_state.json
